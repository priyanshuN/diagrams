#!/bin/bash
# Wrapper: run diagram.py on uv's Python 3.12 (the walkthrough voice uses the same one); plain python3 without uv.
# Usage: pic file.mmd [--look look.json] [--title T] [--theme clean] [-o out.html]
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v uv >/dev/null 2>&1; then
  exec uv run -q --no-project --python 3.12 "$here/diagram.py" "$@"
fi
exec python3 "$here/diagram.py" "$@"
